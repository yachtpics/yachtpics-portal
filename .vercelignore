# Large static assets served from the Supabase Storage bucket `portal-assets`
# instead of from the deployment (see src/lib/assetBase.ts and
# scripts/upload-public-assets.mjs). Kept in the repo so local dev works.
#
# ORDER MATTERS: upload them (node scripts/upload-public-assets.mjs) and set
# NEXT_PUBLIC_ASSETS_BASE in Vercel BEFORE a deployment with this file goes
# out — a deployment without the variable falls back to /public, where these
# files no longer exist, and the Walkthrough look / studio music would fail.
/public/depth/v1/depth-anything-v2-small-q8.onnx
/public/depth/v1/ort-wasm-simd-threaded.wasm
/public/music/*.bin
